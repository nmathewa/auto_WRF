&share
 wrf_core = 'ARW',
 max_dom = 3,
 start_date = '2023-06-20_00:00:00', '2023-06-20_00:00:00', '2023-06-20_00:00:00', 
 end_date   = '2023-06-20_12:00:00', '2023-06-20_12:00:00', '2023-06-20_12:00:00', 
